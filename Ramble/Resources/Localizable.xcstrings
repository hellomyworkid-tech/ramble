          "stringUnit" : {
            "state" : "translated",
            "value" : "AI tidying can use on-device models, or your own API key for Claude, ChatGPT, Gemini and other services. Speech recognition can use Chinese or English, or you can download the open-source Qwen3-ASR model."
          }
        }
      }
